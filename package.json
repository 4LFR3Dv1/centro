{
  "name": "centro",
  "private": true,
  "version": "0.8.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "data:ingest": "node scripts/ingest-detran-v2.mjs",
    "map:data:refresh": "node scripts/refresh-map-data.mjs --strict",
    "map:data:validate": "node scripts/refresh-map-data.mjs --validate-existing",
    "safety:data:refresh": "node scripts/refresh-safety-data-v2.mjs --strict",
    "safety:data:validate": "node scripts/refresh-safety-data-v2.mjs --validate-existing",
    "transit:data:refresh": "node scripts/refresh-transit-data.mjs --strict",
    "transit:data:validate": "node scripts/refresh-transit-data.mjs --validate-existing",
    "db:migrate": "tsx server/db/migrate.ts",
    "ops:test:unit": "tsx --test server/ops/credentials.test.ts server/ops/contracts.test.ts",
    "ops:test:db": "tsx --test server/db/constitution.test.ts server/enrollments/materialize.test.ts",
    "ops:check": "tsc -p tsconfig.server.json --noEmit && npm run ops:test:unit && npm run ops:test:db",
    "build:app": "tsc --noEmit && vite build",
    "build": "npm run data:ingest && npm run build:app",
    "preview": "vite preview",
    "check": "npm run ops:check && npm run data:ingest -- --strict && npm run map:data:validate && npm run safety:data:validate && npm run transit:data:validate && npm run build:app"
  },
  "dependencies": {
    "@node-rs/argon2": "latest",
    "@vitejs/plugin-react": "latest",
    "csv-parse": "latest",
    "maplibre-gl": "^6.7.0",
    "pg": "latest",
    "vite": "latest",
    "typescript": "latest",
    "react": "latest",
    "react-dom": "latest",
    "react-router-dom": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/pg": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "tsx": "latest"
  }
}
